# Cloudflare Pages response headers for the static site (not the /api and /s
# Functions). https://developers.cloudflare.com/pages/configuration/headers/
#
# CSP: everything the pages load is same-origin; the browser only fetches the
# ETH price (CoinGecko) and the streams (Superfluid's subgraph).
# script-src keeps 'unsafe-inline' because every prerendered page carries its
# own inline React Router hydration scripts (and root.tsx's reveal timeout):
# hashing them would take one rule per page, past Pages' 100-rule limit. It
# still blocks scripts from any other origin.
# style-src needs 'unsafe-inline' for the inline critical CSS and the style
# attributes motion animates.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://api.coingecko.com https://subgraph-endpoints.superfluid.dev; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Vite's file names carry a content hash, so a file never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
